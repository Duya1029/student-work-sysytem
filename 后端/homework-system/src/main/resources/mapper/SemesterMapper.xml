<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 学期表 Mapper XML -->
<mapper namespace="com.homework.mapper.SemesterMapper">

    <!-- 结果映射 -->
    <resultMap id="semesterResultMap" type="com.homework.entity.Semester">
        <id property="semesterId" column="semester_id"/>
        <result property="semesterName" column="semester_name"/>
        <result property="startDate" column="start_date"/>
        <result property="endDate" column="end_date"/>
        <result property="status" column="status"/>
        <result property="isCurrent" column="is_current"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- 查询全部学期 -->
    <select id="selectAll" resultMap="semesterResultMap">
        SELECT semester_id, semester_name, start_date, end_date, status, is_current, create_time
        FROM sys_semester
        ORDER BY start_date DESC
    </select>

    <!-- 根据ID查询学期 -->
    <select id="selectById" resultMap="semesterResultMap">
        SELECT semester_id, semester_name, start_date, end_date, status, is_current, create_time
        FROM sys_semester
        WHERE semester_id = #{semesterId}
    </select>

    <!-- 查询当前学期 -->
    <select id="selectCurrent" resultMap="semesterResultMap">
        SELECT semester_id, semester_name, start_date, end_date, status, is_current, create_time
        FROM sys_semester
        WHERE is_current = 1
    </select>

    <!-- 新增学期 -->
    <insert id="insert" parameterType="com.homework.entity.Semester" useGeneratedKeys="true" keyProperty="semesterId">
        INSERT INTO sys_semester (semester_name, start_date, end_date, status, is_current, create_time)
        VALUES (#{semesterName}, #{startDate}, #{endDate},
                <choose>
                    <when test="status != null and status != ''">#{status}</when>
                    <otherwise>'ACTIVE'</otherwise>
                </choose>,
                <choose>
                    <when test="isCurrent != null">#{isCurrent}</when>
                    <otherwise>0</otherwise>
                </choose>,
                SYSUTCDATETIME())
    </insert>

    <!-- 修改学期 -->
    <update id="update" parameterType="com.homework.entity.Semester">
        UPDATE sys_semester
        <set>
            <if test="semesterName != null and semesterName != ''">semester_name = #{semesterName},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="isCurrent != null">is_current = #{isCurrent},</if>
        </set>
        WHERE semester_id = #{semesterId}
    </update>

    <!-- 删除学期 -->
    <delete id="deleteById">
        DELETE FROM sys_semester WHERE semester_id = #{semesterId}
    </delete>

    <!-- 清除所有学期的当前标识 -->
    <update id="clearCurrent">
        UPDATE sys_semester SET is_current = 0
    </update>

    <!-- 设置当前学期 -->
    <update id="setCurrent">
        UPDATE sys_semester SET is_current = 1 WHERE semester_id = #{semesterId}
    </update>

</mapper>
